{
  "name": "spartan-torch",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "CUDA_VERSION": "13.2.1",
      "UBUNTU_VERSION": "24.04",
      "PYTHON_VERSION": "3.13"
    }
  },

  "postCreateCommand": "uv sync --extra dev --extra experiments && .venv/bin/python -c \"import torch; print(f'spartan-torch devcontainer ready! PyTorch {torch.__version__}, CUDA {torch.version.cuda}')\"",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "astral-sh.ruff",
        "charliermarsh.ruff",
        "ms-python.python",
        "nefrob.vscode-just",
        "redhat.vscode-yaml",
        "streetsidesoftware.code-spell-checker",
        "github.vscode-pull-request-github"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.organizeImports.ruff": "explicit",
            "source.fixAll.ruff": "explicit"
          }
        },
        "files.associations": {
          "*.py": "python"
        }
      }
    }
  },
  "forwardPorts": [6006, 8888],
  "portsAttributes": {
    "6006": { "label": "TensorBoard", "onAutoForward": "notify" },
    "8888": { "label": "Jupyter", "onAutoForward": "notify" }
  },
  "mounts": [
    "source=${localEnv:USERPROFILE}/.cache/huggingface,target=/root/.cache/huggingface,type=bind,consistency=cached",
    "source=${localEnv:USERPROFILE}/.config/wandb,target=/root/.config/wandb,type=bind,consistency=cached"
  ],
  "remoteEnv": {
    "PYTHONPATH": "${containerWorkspaceFolder}/src",
    "TORCH_CUDA_ARCH_LIST": "8.0;8.6;8.9;9.0",
    "TRITON_CACHE_DIR": "${containerWorkspaceFolder}/.triton_cache",
    "UV_CACHE_DIR": "${containerWorkspaceFolder}/.uv_cache"
  },
  "runArgs": [
    "--gpus", "all",
    "--shm-size", "8g",
    "--ulimit", "memlock=-1",
    "--ulimit", "stack=67108864"
  ],
  "containerEnv": {
    "DEBIAN_FRONTEND": "noninteractive",
    "PYTHONUNBUFFERED": "1",
    "UV_LINK_MODE": "copy"
  }
}
